---
import Header from '../components/Header.astro';
import '../styles/site.css';
interface Props { title: string; documentTitle?: string }
const { title, documentTitle = "Dr. Aurora Constantin" } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{documentTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <Header title={title} />
  <div class="frame">
    <main id="main" tabindex="-1">
      <slot name="intro"><h1>{title}</h1></slot>
      <div class="cards">
        <slot />
      </div>
    </main>
  </div>
  <footer>© {new Date().getUTCFullYear()} Dr. Aurora Constantin. All rights reserved.</footer>
</body>
</html>

<style>
  body { display: flex; flex-direction: column; min-height: 100vh; }
  .frame { flex: 1; width: 100%; }
  footer { border-top: 1px solid var(--border); padding: 1.25rem var(--page-gutter); color: #47585b; font-size: .875rem; text-align: center; }
</style>
