---
import { sections } from '../data/sections';
interface Props { title: string }
const { title } = Astro.props;
---
<header>
    <nav class="mast" aria-label="Main navigation">
      {sections.map(item => <a href={item.slug ? '/' + item.slug + '/' : '/'} aria-current={item.name === title ? 'page' : undefined}>{item.name}</a>)}
    </nav>
</header>

<style>
  header {
    width: 100%;
    max-width: 100rem;
    margin-inline: auto;
    padding: .85rem var(--page-gutter);
    background: transparent;
  }
  .mast {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    margin-inline: auto;
    gap: .25rem;
    padding: .35rem;
    border: 1px solid #d6e1e1;
    border-radius: 1.15rem;
    background: white;
    box-shadow: 0 3px 12px #18373d0a;
  }
  a {
    display: grid;
    place-items: center;
    min-height: 44px;
    padding: .4rem .2rem;
    border-radius: .85rem;
    color: #35484c;
    font-size: 1.125rem;
    font-weight: 550;
    text-decoration: none;
  }
  a:hover { background: #edf4f4; text-decoration: underline; }
  a[aria-current="page"] { background: var(--accent); color: white; font-weight: 700; }
  a:focus-visible { outline-offset: 1px; }
  @media (max-width: 64rem) {
    .mast { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 32rem) {
    .mast { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
