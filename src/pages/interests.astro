---
import Page from '../layouts/Page.astro';

const interests = [
  { title: 'Music', action: 'Listen to my favourite Celtic song on YouTube', href: 'https://www.youtube.com/watch?v=T8LTs8MBRrM', images: ['music'] },
  { title: 'Painting', action: 'View my paintings on Instagram', href: 'https://www.instagram.com/rorua1/', images: ['painting-3', 'painting-4', 'painting-5'] },
  { title: 'Reading', action: 'Explore Goodreads reading lists', href: 'https://www.goodreads.com/list', images: ['kite-runner', 'thousand-suns', 'nightingale'] },
];
---
<Page title="Interests">
  {interests.map(({ title, action, href, images }) => (
    <a class="interest" href={href}>
      <div class:list={['artwork', title.toLowerCase()]} aria-hidden="true">
        {images.map(image => <img src={'/images/interests/' + image + '.jpg'} alt="" />)}
      </div>
      <div class="caption">
        <h2>{title}</h2>
        <span>{action} <span aria-hidden="true">↗</span></span>
      </div>
    </a>
  ))}
</Page>
<style>
  .interest {
    display: grid;
    grid-template-columns: minmax(16rem, 38%) 1fr;
    align-items: stretch;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    background: white;
    box-shadow: 0 3px 14px #18373d0c;
    text-decoration: none;
  }
  .caption { align-self: center; padding: clamp(1.25rem, 3vw, 3rem); }
  h2 { font-size: clamp(1.6rem, 3vw, 2.5rem); margin-bottom: .45rem; }
  .caption > span { text-decoration: underline; text-underline-offset: .2em; }
  .interest:is(:hover, :focus-visible) { border-color: var(--accent); }
  .artwork { background: #dce8e4; display: flex; justify-content: center; align-items: center; height: 12rem; overflow: hidden; }
  img { display: block; }
  .music {
    --sleeve: 8.5rem;
    position: relative;
    isolation: isolate;
    color: #202e31;
  }
  .music::before, .music::after {
    content: "";
    position: absolute;
    left: calc(50% - var(--sleeve) * .16);
    border-radius: 50%;
  }
  .music::before {
    width: var(--sleeve);
    aspect-ratio: 1;
    background: currentColor;
    border: .4rem double #596565;
    box-shadow: inset 0 0 0 .5rem currentColor, inset 0 0 0 .56rem #526063;
  }
  .music::after {
    width: .32rem;
    height: .32rem;
    margin-left: calc(var(--sleeve) / 2 - .16rem);
    background: currentColor;
    box-shadow: 0 0 0 1.1rem #cf986e;
  }
  .music img {
    position: relative;
    z-index: 1;
    width: var(--sleeve);
    aspect-ratio: 1;
    object-fit: cover;
    border: .35rem solid #faf6ea;
    box-shadow: 0 .25rem .55rem #182d322a;
    transform: translateX(-29%) rotate(-5deg);
  }
  .painting { gap: 3%; padding: .85rem; }
  .painting img { width: 31%; height: auto; max-height: 100%; object-fit: contain; }
  .reading { padding: 1rem; }
  .reading img { height: 100%; max-width: 32%; object-fit: contain; }
  .reading img:first-child { transform: rotate(-7deg); }
  .reading img:last-child { transform: rotate(7deg); }
  @media (max-width: 42rem) {
    .interest { grid-template-columns: 1fr; }
    .artwork { height: 10rem; }
  }
</style>
