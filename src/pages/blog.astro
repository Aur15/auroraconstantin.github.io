---
import Page from '../layouts/Page.astro';
import { posts } from '../data/blog';
---
<Page title="Blog">
  {posts.map(post => (
    <article class="preview" id={post.slug}>
      <a href={`/blog/${post.slug}/`} aria-labelledby={`title-${post.slug}`}>
        <div>
          <h2 id={`title-${post.slug}`}>{post.title}</h2>
          <p>{post.excerpt}</p>
        </div>
        <span aria-hidden="true">→</span>
      </a>
    </article>
  ))}
</Page>
<style>
  .preview a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: clamp(1rem, 2.5vw, 1.75rem);
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: white;
    box-shadow: 0 3px 14px #18373d0c;
    color: var(--ink);
    text-decoration: none;
  }
  .preview a:is(:hover, :focus-visible) h2 { color: var(--accent); text-decoration: underline; }
  .preview p { margin: .5rem 0 0; color: #47585b; }
  .preview span { color: var(--accent); font-size: 1.5rem; }
</style>
